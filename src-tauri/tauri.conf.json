{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Wiki",
  "version": "0.1.0",
  "identifier": "com.llm-wiki.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "LLM Wiki",
        "center": true,
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/embedding-model/"]
  }
}
